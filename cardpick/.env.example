# Required for the "Scan a Card" photo-recognition feature (app/scan).
# Each scan sends one image to the Claude API — this costs real money per
# scan. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional but recommended for the Scan feature's reference-data lookups
# (pokemontcg.io). Without a key, lookups are limited to 1,000/day; with
# one, 20,000/day. Get a free key at https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# Optional override for which Claude model handles card recognition.
# Defaults to claude-sonnet-5.
# ANTHROPIC_VISION_MODEL=claude-sonnet-5
